async function doLogin() {
  const u = document.getElementById('loginUser').value.trim().toLowerCase();
  const p = document.getElementById('loginPass').value;
  const err = document.getElementById('loginErr');
  const btn = document.querySelector('.login-btn');
  err.style.display = 'none';
  if (!u || !p) { err.style.display = 'block'; err.textContent = 'أدخل اسم المستخدم وكلمة المرور!'; return; }

  // تحقق مباشر من الأدمن الأصلي بدون Firebase
  if (u === ROOT_ADMIN.username && p === ROOT_ADMIN.password) {
    currentUser = { username: ROOT_ADMIN.username, name: ROOT_ADMIN.name, role: 'admin', isRoot: true };
    sessionStorage.setItem('lsb_user', JSON.stringify(currentUser));
    // حدّث Firebase بـ plain password عشان يتوافق مع النظام الجديد
    db.ref('lsb_users').once('value').then(snap => {
      if (snap.exists()) {
        const users = snap.val();
        let needsUpdate = false;
        Object.keys(users).forEach(k => {
          // لو الباسورد يبدو إنه hash قديم (btoa) حدّثه
          if (users[k].password && users[k].password !== users[k].plainRef) {
            // مش هنغير باسورد المستخدمين — بس نضيف علامة إن النظام اتحدث
          }
        });
        // تأكد إن admin موجود بـ plain password
        users['admin'] = { name: ROOT_ADMIN.name, password: ROOT_ADMIN.password, role: 'admin', isRoot: true };
        db.ref('lsb_users').set(users).catch(() => {});
      }
    }).catch(() => {});
    showApp();
    return;
  }

  // باقي المستخدمين — جيب من Firebase
  btn.textContent = '⏳ جاري الاتصال...';
  btn.disabled = true;

  await loadUsers();

  btn.textContent = 'دخول';
  btn.disabled = false;

  const found = USERS[u];
  if (!found) {
    err.style.display = 'block';
    err.textContent = 'اسم المستخدم غلط!';
    return;
  }
  if (found.password !== p) {
    err.style.display = 'block';
    err.textContent = 'كلمة المرور غلط!';
    return;
  }
  currentUser = { username: u, name: found.name, role: found.role, isRoot: !!found.isRoot };
  sessionStorage.setItem('lsb_user', JSON.stringify(currentUser));
  showApp();
}

function doLogout() {
  currentUser = null;
  sessionStorage.removeItem('lsb_user');
