}

async function toggleRole(uname) {
  const u = USERS[uname];
  if (!u || u.isRoot) return;
  u.role = u.role === 'admin' ? 'viewer' : 'admin';
  await db.ref(`lsb_users/${uname}`).set(u);
  renderUsers();
}

async function delUser(uname) {
  if (USERS[uname]?.isRoot) return;
  if (uname === currentUser.username) { alert('مش تقدر تحذف نفسك!'); return; }
  if (!confirm(`هتحذف المستخدم @${uname}؟`)) return;
  delete USERS[uname];
  await db.ref(`lsb_users/${uname}`).set(null);
  renderUsers();
}

async function addUser() {
  const name = document.getElementById('au-name').value.trim();
  const username = document.getElementById('au-username').value.trim().toLowerCase();
  const pass = document.getElementById('au-pass').value;
  const role = document.getElementById('au-role').value;
  const err = document.getElementById('auErr');
  err.style.display = 'none';
  err.style.color = 'var(--danger)';
  if (!name || !username || !pass) { err.textContent = 'تأكد من ملء جميع الحقول'; err.style.display = 'block'; return; }
  if (USERS[username]) { err.textContent = 'اسم المستخدم ده موجود بالفعل!'; err.style.display = 'block'; return; }
  if (username.length < 3) { err.textContent = 'اسم المستخدم لازم 3 أحرف على الأقل'; err.style.display = 'block'; return; }
  const newUser = { name, password: pass, role };
  try {
    await db.ref(`lsb_users/${username}`).set(newUser);
    USERS[username] = newUser;
    document.getElementById('au-name').value = '';
    document.getElementById('au-username').value = '';
    document.getElementById('au-pass').value = '';
    err.style.color = 'var(--success)';
    err.textContent = 'تم إضافة المستخدم بنجاح!';
    err.style.display = 'block';
    setTimeout(() => { err.style.display = 'none'; }, 3000);
    renderUsers();
  } catch(e) {
    err.textContent = 'فشل الحفظ — تأكد من Firebase Rules (lsb_users write)';
    err.style.display = 'block';
    console.error('addUser error:', e);
  }
}

