// ─── LOADING UI ───────────────────────────────────────────────
function showLoading(on) {
  // Only show loading overlay if user is already logged in
  if (!currentUser) return;
  document.getElementById('loadingOverlay').style.display = on ? 'flex' : 'none';
}

// حفظ على Firebase
async function saveDB() {
  try {
    // Firebase بيحذف الـ keys الفاضية، فبنحولها لـ object بـ flag
    const toSave = {};
    Object.keys(DB).forEach(k => {
      const arr = DB[k];
      if (Array.isArray(arr) && arr.length === 0) {
        toSave[k] = { __empty: true };
      } else {
        toSave[k] = arr;
      }
    });
    await db.ref('lsb_data').set(toSave);
  } catch(e) {
    console.error('Save error:', e);
  }
}

// تحميل من Firebase مع real-time listener
function loadDB() {
  showLoading(true);
  let firstLoad = true;
  db.ref('lsb_data').on('value', async (snap) => {
    try {
      if (snap.exists()) {
        const loaded = snap.val();
        // دمج الكيز الجديدة لو مش موجودة
        // استعادة الـ arrays الفاضية واللي اتحذفت من Firebase
        Object.keys(DB_DEFAULT).forEach(k => {
          if (!loaded[k]) {
            // الـ key مش موجود خالص في Firebase — استخدم default
            loaded[k] = DB_DEFAULT[k];
          } else if (loaded[k].__empty === true) {
            // array فاضية متعمدة — حافظ عليها فاضية
            loaded[k] = [];
          }
          // لو موجود وعنده بيانات — يفضل كما هو
        });
        DB = loaded;
      } else {
        // أول مرة — ارفع البيانات الافتراضية
        await db.ref('lsb_data').set(DB_DEFAULT);
        DB = JSON.parse(JSON.stringify(DB_DEFAULT));
      }
    } catch(e) {
      console.error('Load error:', e);
    }
    if (firstLoad) {
      showLoading(false);
      switchType('pro');
      firstLoad = false;
    }
    render();
  }, (error) => {
    console.error('Listener error:', error);
    showLoading(false);
  });
}

// ─── STATE ────────────────────────────────────────────────────
let mainTab = 'shajr';
let ampType = 'pro';

// ─── COLORS ───────────────────────────────────────────────────
const TYPE_COLOR = { pro:'var(--pro)', lsb2:'var(--lsb2)', lsba:'var(--lsba)' };
const TAB_ACT    = { shajr:'act-shajr', hayt:'act-hayt', sheala:'act-sheala', kost:'act-kost', group:'act-group', bodyw:'act-bodyw', ajsam:'act-ajsam', nahas:'act-nahas' };
const TAB_ICON   = { shajr:'🟢 بالتة شجر', hayt:'🧱 بالتة حائط', sheala:'🔵 شيالات', kost:'📐 كوستيلا', group:'🔢 كود المجموعة', bodyw:'📏 عرض الجسم', ajsam:'🧩 الأجسام', nahas:'🟤 نحاس التجميع' };
const TYPE_ACT   = { pro:'act-pro', lsb2:'act-lsb2', lsba:'act-lsba' };
const TYPE_LABEL = { pro:'LSB PRO', lsb2:'LSB 2', lsba:'LSB A' };
const READONLY_TABS = [];

function fmtAmp(n) { return n.toString(); }
function fmtDim(n) { if (n === undefined || n === null || isNaN(n)) return '—'; return parseFloat(n.toFixed(2)).toString(); }

// ─── SWITCH MAIN TAB ──────────────────────────────────────────
function switchMain(tab) {
  mainTab = tab;
  ['shajr','hayt','sheala','kost','group','bodyw','ajsam','nahas'].forEach(t => {
    const el = document.getElementById(`mtab-${t}`);
    el.className = 'main-tab' + (t === tab ? ` ${TAB_ACT[t]}` : '');
  });
  document.getElementById('typeSelector').classList.remove('hidden');
  document.getElementById('searchBox').classList.remove('hidden');
  document.getElementById('resultCard').className = 'result-card';
  document.getElementById('tableSection').classList.remove('hidden');
  document.getElementById('addBtnEl').style.display = '';
  document.getElementById('readonlyNote').classList.add('hidden');
  document.getElementById('haytFormulaNote').classList.toggle('hidden', tab !== 'hayt');
  render();
}

// ─── SWITCH AMP TYPE ──────────────────────────────────────────
function switchType(type) {
  ampType = type;
  ['pro','lsb2','lsba'].forEach(t => {
    document.getElementById(`tbtn-${t}`).className = 'type-btn' + (t === type ? ` ${TYPE_ACT[t]}` : '');
  });
  document.getElementById('resultCard').className = 'result-card';
  const sb = document.getElementById('searchBox');
  sb.style.borderColor = TYPE_COLOR[type];
  const btn = document.getElementById('searchBtn');
  btn.style.background = TYPE_COLOR[type];
  document.getElementById('searchInput').style.borderColor = '';
  render();
}

function key()  { return `${mainTab}_${ampType}`; }
function data() { return DB[key()] || (DB[key()]= []); }

function isSingleDim() { return mainTab === 'sheala' || mainTab === 'kost'; }
function isGroup()     { return mainTab === 'group'; }
function isBodyW()     { return mainTab === 'bodyw'; }
function isHayt()      { return mainTab === 'hayt'; }
function isAjsam()     { return mainTab === 'ajsam'; }
function isNahas()     { return mainTab === 'nahas'; }

function getBodyWidth(amp) {
  const bwKey = `bodyw_${ampType}`;
  const bwData = DB[bwKey] || [];
  const rec = bwData.find(d => d.amp === amp);
  return rec ? rec.bw : null;
}

// ─── RENDER TABLE ─────────────────────────────────────────────
function render() {
  const d = data();
  d.sort((a,b)=>a.amp-b.amp);
  const color = TYPE_COLOR[ampType];
  const colClass = `amp-${ampType}`;
  document.getElementById('tableTitle').textContent = `${TAB_ICON[mainTab]} — ${TYPE_LABEL[ampType]}`;

  const thead = document.getElementById('tableHead');
  let colHeaders = '';
  if (isGroup())       colHeaders = '<th>كود المجموعة</th>';
  else if (isBodyW())  colHeaders = '<th>عرض الجسم (cm)</th>';
  else if (isHayt())   colHeaders = '<th>العرض (cm)</th><th>الارتفاع (cm)</th>';
  else if (isAjsam())  colHeaders = '<th>Casing A</th><th>Casing B</th><th>الأشكال الخاصة</th>';
  else if (isNahas())  colHeaders = '<th>الطول (mm)</th><th>العرض (mm)</th><th>السمك (mm)</th><th>العدد لكل باره</th>';
  else if (mainTab === 'sheala') colHeaders = '<th>الطول (cm)</th>';
  else                 colHeaders = '<th>المقاس (cm)</th>';

  thead.innerHTML = `<tr><th>الأمبير</th>${colHeaders}<th></th></tr>`;

  const ab = document.getElementById('addBtnEl');
  ab.style.borderColor = color;
  ab.style.color = color;

  const tbody = document.getElementById('tableBody');
  tbody.innerHTML = '';

  d.forEach((item, i) => {
    const tr = document.createElement('tr');
    tr.id = `row-${key()}-${item.amp}`;
    let cells = '';
    if (isGroup()) {
      cells = `<td class="dims" style="color:var(--group);font-size:1rem;letter-spacing:1px">${item.code}</td>`;
    } else if (isBodyW()) {
      cells = `<td class="dims" style="color:var(--body-w)">${fmtDim(item.bw)} cm</td>`;
    } else if (isHayt()) {
      const bw = getBodyWidth(item.amp);
      const wallW = bw !== null ? fmtDim(bw + 31) : fmtDim(item.w);
      cells = `<td class="dims">${wallW}</td><td class="dims">45</td>`;
    } else if (isAjsam()) {
      cells = `<td class="dims">${fmtDim(item.casingA)}</td><td class="dims">${fmtDim(item.casingB)}</td><td class="dims">${fmtDim(item.shapes)}</td>`;
    } else if (isNahas()) {
      cells = `<td class="dims">${fmtDim(item.len)}</td><td class="dims">${fmtDim(item.w)}</td><td class="dims">${fmtDim(item.thick)}</td><td class="dims">${fmtDim(item.count)}</td>`;
    } else if (isSingleDim()) {
      cells = `<td class="dims">${fmtDim(item.len)} cm</td>`;
    } else {
      cells = `<td class="dims">${fmtDim(item.w)} × ${fmtDim(item.h)}</td>`;
    }
    tr.innerHTML = `<td class="${colClass}" style="color:${color}">${fmtAmp(item.amp)}</td>${cells}<td><button class="del-btn" onclick="window._deleteEntry(${i})">✕</button></td>`;
    tbody.appendChild(tr);
  });
  buildAddForm();
}

// ─── ADD FORM ─────────────────────────────────────────────────
function buildAddForm() {
  const color = TYPE_COLOR[ampType];
  const form = document.getElementById('addForm');
  form.style.borderColor = color;
  form.classList.remove('open');
  const row = document.getElementById('addFormRow');

  if (isGroup()) {
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" /><input type="text" id="na-code" placeholder="كود المجموعة" style="flex:2" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  } else if (isBodyW()) {
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" /><input type="number" id="na-bw" placeholder="عرض الجسم (cm)" step="0.01" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  } else if (isAjsam()) {
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" /><input type="number" id="na-casinga" placeholder="Casing A" step="0.01" /><input type="number" id="na-casingb" placeholder="Casing B" step="0.01" /><input type="number" id="na-shapes" placeholder="الأشكال الخاصة" step="0.01" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  } else if (isNahas()) {
    row.innerHTML = `<input type="number" id="na-len" placeholder="الطول (mm)" step="0.01" /><input type="number" id="na-w" placeholder="العرض (mm)" step="0.01" /><input type="number" id="na-thick" placeholder="السمك (mm)" step="0.01" /><input type="number" id="na-count" placeholder="العدد لكل باره" step="0.01" /><input type="number" id="na-amp" placeholder="الأمبير" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  } else if (isSingleDim()) {
    const ph = mainTab === 'kost' ? 'المقاس (cm)' : 'الطول (cm)';
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" /><input type="number" id="na-len" placeholder="${ph}" step="0.01" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  } else if (isHayt()) {
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" oninput="window._previewHaytW()" /><div style="flex:1;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;text-align:center;font-size:0.85rem;color:var(--hayt)" id="hayt-w-preview">العرض: —</div><div style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;text-align:center;font-size:0.85rem;color:var(--muted);white-space:nowrap">ارتفاع: 45 سم</div><button class="save-btn" style="background:${color}" onclick="window._addEntryHayt()">حفظ</button>`;
  } else {
    row.innerHTML = `<input type="number" id="na-amp" placeholder="الأمبير" /><input type="number" id="na-w" placeholder="عرض (cm)" step="0.01" /><span class="sep">×</span><input type="number" id="na-h" placeholder="ارتفاع (cm)" step="0.01" /><button class="save-btn" style="background:${color}" onclick="window._addEntry()">حفظ</button>`;
  }
}

function previewHaytW() {
  const amp = parseInt(document.getElementById('na-amp')?.value);
  const preview = document.getElementById('hayt-w-preview');
  if (!preview) return;
  if (!amp) { preview.textContent = 'العرض: —'; return; }
  const bw = getBodyWidth(amp);
  if (bw !== null) {
    preview.textContent = `العرض: ${fmtDim(bw + 31)} سم`;
    preview.style.color = 'var(--hayt)';
  } else {
    preview.textContent = 'عرض الجسم غير موجود!';
    preview.style.color = 'var(--danger)';
  }
}

function toggleAddForm() {
  document.getElementById('addForm').classList.toggle('open');
  document.getElementById('errMsg').style.display = 'none';
}

async function addEntry() {
  if (!currentUser || currentUser.role !== 'admin') return;
  const err = document.getElementById('errMsg');
  err.style.display = 'none';
  err.textContent = 'تأكد من إدخال جميع الحقول';
  const amp = parseInt(document.getElementById('na-amp')?.value);
  if (!amp) { err.style.display = 'block'; return; }
  if (data().find(d => d.amp === amp)) { err.textContent = 'الأمبير ده موجود بالفعل!'; err.style.display = 'block'; return; }

  if (isGroup()) {
    const code = document.getElementById('na-code')?.value?.trim();
    if (!code) { err.style.display = 'block'; return; }
    data().push({amp, code});
  } else if (isBodyW()) {
    const bw = parseFloat(document.getElementById('na-bw')?.value);
    if (!bw) { err.style.display = 'block'; return; }
    data().push({amp, bw});
  } else if (isAjsam()) {
    const casingA = parseFloat(document.getElementById('na-casinga')?.value);
    const casingB = parseFloat(document.getElementById('na-casingb')?.value);
    const shapes  = parseFloat(document.getElementById('na-shapes')?.value);
    if (isNaN(casingA) || isNaN(casingB) || isNaN(shapes)) { err.style.display = 'block'; return; }
    data().push({amp, casingA, casingB, shapes});
  } else if (isNahas()) {
    const len   = parseFloat(document.getElementById('na-len')?.value);
    const w     = parseFloat(document.getElementById('na-w')?.value);
    const thick = parseFloat(document.getElementById('na-thick')?.value);
    const count = parseFloat(document.getElementById('na-count')?.value);
    if (!len || !w || !thick || !count) { err.style.display = 'block'; return; }
    data().push({amp, len, w, thick, count});
  } else if (isSingleDim()) {
    const len = parseFloat(document.getElementById('na-len')?.value);
    if (!len) { err.style.display = 'block'; return; }
    data().push({amp, len});
  } else {
    const w = parseFloat(document.getElementById('na-w')?.value);
    const h = parseFloat(document.getElementById('na-h')?.value);
    if (!w || !h) { err.style.display = 'block'; return; }
    data().push({amp, w, h});
  }
  await saveDB();
  document.getElementById('addForm').classList.remove('open');
  render();
}

async function addEntryHayt() {
  if (!currentUser || currentUser.role !== 'admin') return;
  const err = document.getElementById('errMsg');
  err.style.display = 'none';
  err.textContent = 'تأكد من إدخال جميع الحقول';
  const amp = parseInt(document.getElementById('na-amp')?.value);
  if (!amp) { err.style.display = 'block'; return; }
  if (data().find(d => d.amp === amp)) { err.textContent = 'الأمبير ده موجود بالفعل!'; err.style.display = 'block'; return; }
  const bw = getBodyWidth(amp);
  if (bw === null) {
    err.textContent = 'مفيش عرض جسم لهذا الأمبير — أضف الأمبير في تبويب "عرض الجسم" أولاً';
    err.style.display = 'block'; return;
  }
  data().push({ amp, w: bw + 31, h: 45 });
  await saveDB();
  document.getElementById('addForm').classList.remove('open');
  render();
}

async function deleteEntry(idx) {
  if (!currentUser || currentUser.role !== 'admin') return;
  const d = data();
  if (confirm(`هتحذف أمبير ${fmtAmp(d[idx].amp)}؟`)) {
    d.splice(idx, 1);
    await saveDB();
    render();
  }
}

// ─── SEARCH ───────────────────────────────────────────────────
function doSearch() {
  const val = parseInt(document.getElementById('searchInput').value);
  const card  = document.getElementById('resultCard');
  const label = document.getElementById('resultLabel');
  const cont  = document.getElementById('resultContent');
  card.className = 'result-card';
  if (!val) return;
  const found = data().find(d => d.amp === val);
  const color = TYPE_COLOR[ampType];
  const typeLabel = TYPE_LABEL[ampType];

  if (found) {
    card.classList.add('found');
    label.textContent = '✔ تم العثور على البيانات';
    if (isGroup()) {
      cont.innerHTML = `<div class="result-dims" style="color:var(--group)">${found.code}</div><div class="result-sub">كود المجموعة — ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else if (isBodyW()) {
      cont.innerHTML = `<div class="result-dims" style="color:var(--body-w)">${fmtDim(found.bw)} cm</div><div class="result-sub">عرض الجسم — ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else if (isHayt()) {
      const bw = getBodyWidth(found.amp);
      const wallW = bw !== null ? fmtDim(bw + 31) : fmtDim(found.w);
      cont.innerHTML = `<div class="result-dims">${wallW} × 45 cm</div><div class="result-sub" style="color:var(--hayt)">عرض = عرض الجسم (${bw !== null ? bw : '?'}) + 31 &nbsp;|&nbsp; ارتفاع ثابت 45 سم</div><div class="result-sub">${TAB_ICON[mainTab]} ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else if (isAjsam()) {
      cont.innerHTML = `<div class="result-dims" style="color:var(--ajsam);font-size:1.3rem">Casing A: ${fmtDim(found.casingA)} &nbsp;|&nbsp; Casing B: ${fmtDim(found.casingB)} &nbsp;|&nbsp; أشكال خاصة: ${fmtDim(found.shapes)}</div><div class="result-sub">الأجسام — ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else if (isNahas()) {
      cont.innerHTML = `<div class="result-dims" style="color:var(--nahas);font-size:1.3rem">${fmtDim(found.len)}*${fmtDim(found.thick)}*${fmtDim(found.w)}*${fmtDim(found.count)}</div><div class="result-sub">نحاس التجميع — ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else if (isSingleDim()) {
      const label2 = mainTab === 'kost' ? 'كوستيلا' : 'شيالة';
      cont.innerHTML = `<div class="result-dims">${fmtDim(found.len)} cm</div><div class="result-sub">${label2} ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    } else {
      cont.innerHTML = `<div class="result-dims">${fmtDim(found.w)} × ${fmtDim(found.h)} cm</div><div class="result-sub">${TAB_ICON[mainTab]} ${typeLabel} — أمبير <span style="color:${color}">${fmtAmp(found.amp)}</span></div>`;
    }
    document.querySelectorAll('tbody tr').forEach(r => r.classList.remove('highlight'));
    const row = document.getElementById(`row-${key()}-${found.amp}`);
    if (row) { row.classList.add('highlight'); row.scrollIntoView({behavior:'smooth', block:'nearest'}); }
  } else {
    card.classList.add('not-found');
    label.textContent = '✘ الأمبير غير موجود';
    cont.innerHTML = `<div class="result-msg">مفيش بيانات لأمبير <strong>${val}</strong> في ${typeLabel}</div>`;
  }
}

// ─── EXPOSE TO HTML (module scope fix) ────────────────────────
window._addEntry      = addEntry;
window._addEntryHayt  = addEntryHayt;
window._deleteEntry   = deleteEntry;
window._previewHaytW  = previewHaytW;
window.switchMain     = switchMain;
window.switchType     = switchType;
window.toggleAddForm  = toggleAddForm;
window.doSearch       = doSearch;

// ─── KEYBOARD ─────────────────────────────────────────────────
document.getElementById('searchInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });

// ─── INIT ─────────────────────────────────────────────────────
// loadDB is called from showApp() after successful login
</script>
</body>
</html>
