<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>مقاسات LSB</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #0d0f18;
    --surface: #161927;
    --card: #1e2235;
    --border: #272d45;
    --text: #eef0f8;
    --muted: #6b7291;

    --pro: #f5a623;
    --pro2: #e8891a;
    --pro-bg: #1c1608;

    --lsb2: #3b9eff;
    --lsb2d: #2280d4;
    --lsb2-bg: #080f1c;

    --lsba: #b06fff;
    --lsbad: #9055e8;
    --lsba-bg: #10081c;

    --shajr: #f5a623;
    --hayt: #00d4aa;
    --haytd: #00b893;
    --hayt-bg: #04161300;
    --kost: #ff6b6b;
    --kostd: #e85555;

    --group: #f0c040;
    --body-w: #a78bfa;
    --ajsam: #ff6bcb;
    --nahas: #c87137;

    --success: #2ecc71;
    --danger: #e74c3c;
  }

  body {
    font-family: 'Cairo', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 14px 60px;
  }

  .header { text-align: center; margin-bottom: 22px; }
  .header h1 {
    font-size: 1.75rem; font-weight: 900; letter-spacing: 1px;
    background: linear-gradient(90deg, var(--pro), var(--lsb2), var(--lsba));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .header p { color: var(--muted); font-size: 0.82rem; margin-top: 4px; }

  /* ─── MAIN TABS ─── */
  .main-tabs {
    display: flex; gap: 6px; width: 100%; max-width: 560px;
    margin-bottom: 18px; flex-wrap: wrap;
  }
  .main-tab {
    flex: 1; min-width: 90px; padding: 10px 6px;
    border-radius: 12px; border: 2px solid var(--border);
    background: var(--surface); color: var(--muted);
    font-family: 'Cairo', sans-serif; font-size: 0.83rem;
    font-weight: 700; cursor: pointer; transition: all 0.2s; text-align: center;
  }
  .main-tab.act-shajr  { border-color: var(--shajr); color: var(--shajr); background: #1c160800; }
  .main-tab.act-hayt   { border-color: var(--hayt);  color: var(--hayt);  background: #04161300; }
  .main-tab.act-sheala { border-color: var(--lsb2);  color: var(--lsb2);  background: var(--lsb2-bg); }
  .main-tab.act-kost   { border-color: var(--kost);  color: var(--kost);  background: #1c080800; }
  .main-tab.act-group  { border-color: var(--group); color: var(--group); background: #1c150000; }
  .main-tab.act-bodyw  { border-color: var(--body-w);color: var(--body-w);background: #0e0c1c; }
  .main-tab.act-ajsam  { border-color: var(--ajsam); color: var(--ajsam); background: #1c0e18; }
  .main-tab.act-nahas  { border-color: var(--nahas); color: var(--nahas); background: #1c1108; }

  /* ─── AMP TYPE SELECTOR ─── */
  .type-selector {
    display: flex; gap: 8px; width: 100%; max-width: 560px; margin-bottom: 18px;
  }
  .type-btn {
    flex: 1; padding: 9px 6px; border-radius: 10px; border: 2px solid var(--border);
    background: var(--surface); color: var(--muted);
    font-family: 'Cairo', sans-serif; font-size: 0.85rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s; text-align: center;
  }
  .type-btn.act-pro  { border-color: var(--pro);  color: var(--pro);  background: var(--pro-bg); }
  .type-btn.act-lsb2 { border-color: var(--lsb2); color: var(--lsb2); background: var(--lsb2-bg); }
  .type-btn.act-lsba { border-color: var(--lsba); color: var(--lsba); background: var(--lsba-bg); }

  /* ─── SEARCH ─── */
  .search-box {
    width: 100%; max-width: 560px; background: var(--surface);
    border: 2px solid var(--border); border-radius: 14px;
    padding: 16px 20px; margin-bottom: 16px; transition: border-color 0.2s;
  }
  .search-box label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 10px; font-weight: 600; }
  .input-row { display: flex; gap: 10px; }
  .search-box input {
    flex: 1; background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
    padding: 11px 14px; font-family: 'Cairo', sans-serif; font-size: 1.05rem;
    font-weight: 700; color: var(--text); text-align: center; outline: none; transition: border-color 0.2s;
  }
  .search-box input::placeholder { color: var(--muted); font-weight: 400; }
  .btn {
    border: none; border-radius: 10px; padding: 11px 18px;
    font-family: 'Cairo', sans-serif; font-weight: 700; font-size: 0.9rem;
    cursor: pointer; transition: background 0.2s, transform 0.1s; white-space: nowrap; color: #0d0f18;
  }
  .btn:active { transform: scale(0.97); }

  /* ─── RESULT ─── */
  .result-card {
    width: 100%; max-width: 560px; border-radius: 14px;
    padding: 18px 22px; margin-bottom: 16px; display: none; animation: fadeIn 0.3s ease;
  }
  .result-card.found     { background: linear-gradient(135deg,#0e1f12,#122018); border: 2px solid var(--success); display: block; }
  .result-card.not-found { background: linear-gradient(135deg,#1f0e0e,#201212); border: 2px solid var(--danger);  display: block; }
  .result-label { font-size: 0.78rem; font-weight: 700; letter-spacing: 1px; margin-bottom: 6px; }
  .result-card.found .result-label  { color: var(--success); }
  .result-card.not-found .result-label { color: var(--danger); }
  .result-dims { font-size: 2rem; font-weight: 900; color: var(--text); line-height: 1.1; }
  .result-sub  { font-size: 0.85rem; margin-top: 5px; color: var(--muted); }
  .result-sub span { font-weight: 700; }
  .result-msg  { font-size: 0.95rem; color: var(--text); }

  /* ─── TABLE ─── */
  .table-section { width: 100%; max-width: 560px; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .section-title { font-size: 0.78rem; font-weight: 700; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  .add-btn {
    background: transparent; border-radius: 8px; padding: 5px 13px;
    font-family: 'Cairo', sans-serif; font-size: 0.8rem; font-weight: 700;
    cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  .table-wrap { background: var(--surface); border-radius: 13px; border: 1px solid var(--border); overflow: hidden; }
  table { width: 100%; border-collapse: collapse; }
  thead tr { background: var(--card); }
  th { padding: 10px 12px; font-size: 0.76rem; color: var(--muted); font-weight: 700; text-align: center; }
  tbody tr { border-top: 1px solid var(--border); transition: background 0.15s; }
  tbody tr:hover { background: var(--card); }
  td { padding: 9px 12px; text-align: center; font-size: 0.9rem; }
  td.amp-pro  { font-weight: 700; color: var(--pro); }
  td.amp-lsb2 { font-weight: 700; color: var(--lsb2); }
  td.amp-lsba { font-weight: 700; color: var(--lsba); }
  td.dims { font-weight: 600; color: var(--text); }
  .del-btn {
    background: transparent; border: none; color: var(--muted);
    cursor: pointer; font-size: 0.95rem; padding: 2px 6px;
    border-radius: 6px; transition: color 0.15s, background 0.15s;
  }
  .del-btn:hover { color: var(--danger); background: #2a1a1a; }

  /* ─── ADD FORM ─── */
  .add-form {
    background: var(--card); border-radius: 12px; padding: 13px;
    margin-top: 10px; display: none; animation: fadeIn 0.2s ease;
  }
  .add-form.open { display: block; }
  .add-form .row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .add-form input {
    flex: 1; min-width: 70px; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 8px 10px;
    font-family: 'Cairo', sans-serif; font-size: 0.9rem;
    color: var(--text); text-align: center; outline: none; transition: border-color 0.2s;
  }
  .add-form input::placeholder { color: var(--muted); font-size: 0.78rem; }
  .sep { color: var(--muted); font-weight: 700; font-size: 1rem; }
  .save-btn {
    border: none; border-radius: 8px; padding: 8px 14px;
    font-family: 'Cairo', sans-serif; font-weight: 700; font-size: 0.85rem;
    cursor: pointer; transition: background 0.2s; color: #0d0f18;
  }
  .err-msg { color: var(--danger); font-size: 0.76rem; margin-top: 6px; display: none; }

  /* ─── READ-ONLY TABS (group / body-w) ─── */
  .readonly-note {
    font-size: 0.72rem; color: var(--muted); text-align: center;
    margin-bottom: 8px; font-style: italic;
  }

  /* بالتة حائط — extra info row */
  .hayt-formula {
    font-size: 0.75rem; color: var(--hayt); text-align: center;
    margin-bottom: 10px; font-weight: 600;
  }

  .hidden { display: none !important; }
  .highlight { background: var(--card) !important; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .c-pro  { color: var(--pro);  }
  .c-lsb2 { color: var(--lsb2); }
  .c-lsba { color: var(--lsba); }
  .c-hayt { color: var(--hayt); }
  .c-kost { color: var(--kost); }

  .focus-pro  input:focus { border-color: var(--pro)  !important; }
  .focus-lsb2 input:focus { border-color: var(--lsb2) !important; }
  .focus-lsba input:focus { border-color: var(--lsba) !important; }
  .focus-hayt input:focus { border-color: var(--hayt) !important; }
  .focus-kost input:focus { border-color: var(--kost) !important; }

  /* ─── LOGIN SCREEN ─── */
  #loginScreen {
    display: flex; position: fixed; inset: 0; background: var(--bg);
    z-index: 10000; flex-direction: column; align-items: center; justify-content: center;
    padding: 20px; animation: fadeIn 0.4s ease;
  }
  .login-box {
    width: 100%; max-width: 400px; background: var(--surface);
    border: 2px solid var(--border); border-radius: 20px; padding: 36px 30px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  .login-logo { text-align: center; margin-bottom: 28px; }
  .login-logo h2 {
    font-size: 1.8rem; font-weight: 900;
    background: linear-gradient(90deg, var(--pro), var(--lsb2), var(--lsba));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .login-logo p { color: var(--muted); font-size: 0.8rem; margin-top: 4px; }
  .login-field { margin-bottom: 16px; }
  .login-field label { display: block; font-size: 0.78rem; color: var(--muted); font-weight: 700; margin-bottom: 7px; letter-spacing: 0.5px; }
  .login-field input {
    width: 100%; background: var(--bg); border: 2px solid var(--border); border-radius: 11px;
    padding: 12px 16px; font-family: 'Cairo', sans-serif; font-size: 0.95rem;
    color: var(--text); outline: none; transition: border-color 0.2s; text-align: right;
  }
  .login-field input:focus { border-color: var(--pro); }
  .login-btn {
    width: 100%; padding: 13px; background: linear-gradient(90deg, var(--pro), var(--pro2));
    border: none; border-radius: 11px; font-family: 'Cairo', sans-serif; font-weight: 800;
    font-size: 1rem; color: #0d0f18; cursor: pointer; transition: opacity 0.2s, transform 0.1s;
    margin-top: 8px;
  }
  .login-btn:hover { opacity: 0.9; }
  .login-btn:active { transform: scale(0.98); }
  .login-err { color: var(--danger); font-size: 0.8rem; text-align: center; margin-top: 10px; display: none; }

  /* ─── TOP BAR ─── */
  .top-bar {
    display: flex; justify-content: space-between; align-items: center;
    width: 100%; max-width: 560px; margin-bottom: 16px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 13px; padding: 10px 16px;
  }
  .user-info { display: flex; align-items: center; gap: 8px; }
  .user-avatar {
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; font-weight: 800; color: #0d0f18;
  }
  .user-name { font-size: 0.85rem; font-weight: 700; color: var(--text); }
  .user-role-badge {
    font-size: 0.68rem; font-weight: 700; padding: 2px 8px;
    border-radius: 20px; letter-spacing: 0.5px;
  }
  .role-admin { background: rgba(245,166,35,0.2); color: var(--pro); border: 1px solid var(--pro); }
  .role-viewer { background: rgba(59,158,255,0.15); color: var(--lsb2); border: 1px solid var(--lsb2); }
  .top-bar-btns { display: flex; gap: 8px; align-items: center; }
  .icon-btn {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 6px 10px; font-size: 0.8rem; font-weight: 700; color: var(--muted);
    cursor: pointer; transition: all 0.2s; font-family: 'Cairo', sans-serif;
  }
  .icon-btn:hover { border-color: var(--pro); color: var(--pro); }

  /* ─── USERS PANEL ─── */
  #usersPanel {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7);
    z-index: 9000; align-items: flex-end; justify-content: center;
    animation: fadeIn 0.2s ease;
  }
  #usersPanel.open { display: flex; }
  .users-sheet {
    width: 100%; max-width: 560px; background: var(--surface);
    border-radius: 20px 20px 0 0; border: 1px solid var(--border);
    padding: 24px 20px 40px; max-height: 85vh; overflow-y: auto;
  }
  .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .panel-title { font-size: 1rem; font-weight: 800; color: var(--text); }
  .close-panel-btn {
    background: var(--card); border: 1px solid var(--border); border-radius: 8px;
    padding: 6px 12px; color: var(--muted); cursor: pointer; font-size: 0.85rem;
    font-family: 'Cairo', sans-serif; transition: all 0.2s;
  }
  .close-panel-btn:hover { color: var(--danger); border-color: var(--danger); }
  .users-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .user-card {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 12px 16px; display: flex; align-items: center; gap: 12px;
    transition: border-color 0.2s;
  }
  .user-card:hover { border-color: var(--border); }
  .user-card .uc-info { flex: 1; }
  .user-card .uc-name { font-size: 0.9rem; font-weight: 700; color: var(--text); }
  .user-card .uc-user { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
  .user-card .uc-actions { display: flex; gap: 6px; align-items: center; }
  .role-toggle-btn {
    border: none; border-radius: 7px; padding: 5px 10px;
    font-family: 'Cairo', sans-serif; font-size: 0.72rem; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .del-user-btn {
    background: transparent; border: 1px solid #3a1f1f; border-radius: 7px;
    padding: 5px 9px; color: var(--muted); cursor: pointer; font-size: 0.8rem;
    transition: all 0.2s;
  }
  .del-user-btn:hover { color: var(--danger); border-color: var(--danger); background: #2a1a1a; }
  .add-user-form {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 16px; margin-top: 6px;
  }
  .add-user-form .au-title { font-size: 0.8rem; font-weight: 700; color: var(--muted); margin-bottom: 12px; letter-spacing: 0.5px; }
  .add-user-form .au-fields { display: flex; flex-direction: column; gap: 8px; }
  .add-user-form input, .add-user-form select {
    width: 100%; background: var(--bg); border: 1px solid var(--border); border-radius: 9px;
    padding: 10px 14px; font-family: 'Cairo', sans-serif; font-size: 0.88rem;
    color: var(--text); outline: none; transition: border-color 0.2s; text-align: right;
  }
  .add-user-form input:focus, .add-user-form select:focus { border-color: var(--pro); }
  .add-user-form select option { background: var(--card); }
  .au-submit-btn {
    width: 100%; padding: 10px; margin-top: 4px;
    background: linear-gradient(90deg, var(--pro), var(--pro2));
    border: none; border-radius: 9px; font-family: 'Cairo', sans-serif;
    font-weight: 800; font-size: 0.9rem; color: #0d0f18; cursor: pointer;
    transition: opacity 0.2s;
  }
  .au-submit-btn:hover { opacity: 0.9; }
  .au-err { color: var(--danger); font-size: 0.75rem; margin-top: 6px; display: none; }
  .divider { height: 1px; background: var(--border); margin: 16px 0; }

  /* viewer: hide add/delete buttons */
  body.viewer-mode .add-btn { display: none !important; }
  body.viewer-mode .del-btn { display: none !important; }
  body.viewer-mode .add-form { display: none !important; }
</style>
</head>
<body>

<!-- ─── LOGIN SCREEN ─── -->
<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">
      <h2>⚡ دليل التنزيلات</h2>
      <p>LSB PRO · LSB 2 · LSB A</p>
    </div>
    <div class="login-field">
      <label>اسم المستخدم</label>
      <input type="text" id="loginUser" placeholder="أدخل اسم المستخدم" autocomplete="username" />
    </div>
    <div class="login-field">
      <label>كلمة المرور</label>
      <input type="password" id="loginPass" placeholder="أدخل كلمة المرور" autocomplete="current-password" />
    </div>
    <button class="login-btn" onclick="doLogin()">دخول</button>
    <div class="login-err" id="loginErr">اسم المستخدم أو كلمة المرور غلط!</div>
  </div>
</div>

<!-- ─── USERS PANEL (admin only) ─── -->
<div id="usersPanel">
  <div class="users-sheet">
    <div class="panel-header">
      <span class="panel-title">👥 إدارة المستخدمين</span>
      <button class="close-panel-btn" onclick="closeUsersPanel()">✕ إغلاق</button>
    </div>
    <div class="users-list" id="usersList"></div>
    <div class="divider"></div>
    <div class="add-user-form">
      <div class="au-title">➕ إضافة مستخدم جديد</div>
      <div class="au-fields">
        <input type="text" id="au-name" placeholder="الاسم الكامل" />
        <input type="text" id="au-username" placeholder="اسم المستخدم (username)" />
        <input type="password" id="au-pass" placeholder="كلمة المرور" />
        <select id="au-role">
          <option value="viewer">فيوير — عرض فقط</option>
          <option value="admin">أدمن — إضافة وحذف</option>
        </select>
        <button class="au-submit-btn" onclick="addUser()">إضافة</button>
        <div class="au-err" id="auErr">تأكد من ملء جميع الحقول</div>
      </div>
    </div>
  </div>
</div>

<div class="header">
  <h1>⚡ دليل التنزيلات</h1>
  <p>PRO · LSB 2 · LSB A — بالتة شجر · بالتة حائط · شيالات · كوستيلا · كود المجموعة · عرض الجسم</p>
</div>

<!-- LOADING OVERLAY -->
<div id="loadingOverlay" style="display:flex;position:fixed;inset:0;background:#0d0f18;z-index:9999;flex-direction:column;align-items:center;justify-content:center;gap:16px">
  <div style="width:48px;height:48px;border:4px solid #272d45;border-top-color:#f5a623;border-radius:50%;animation:spin 0.8s linear infinite"></div>
  <div style="color:#6b7291;font-size:0.95rem">جاري تحميل البيانات...</div>
</div>
<style>@keyframes spin{to{transform:rotate(360deg)}}</style>

<!-- TOP BAR (shown after login) -->
<div class="top-bar" id="topBar" style="display:none">
  <div class="user-info">
    <div class="user-avatar" id="userAvatar" style="background:var(--pro)"></div>
    <div>
      <div class="user-name" id="userNameDisplay"></div>
      <div style="margin-top:2px"><span class="user-role-badge" id="userRoleBadge"></span></div>
    </div>
  </div>
  <div class="top-bar-btns">
    <button class="icon-btn" id="adminPanelBtn" onclick="openUsersPanel()" style="display:none">👥 المستخدمين</button>
    <button class="icon-btn" onclick="doLogout()">🚪 خروج</button>
  </div>
</div>
<div class="search-box" id="searchBox">
  <label id="searchLabel">ادخل الأمبير</label>
  <div class="input-row">
    <input type="number" id="searchInput" placeholder="مثال: 2000" />
    <button class="btn" id="searchBtn" onclick="doSearch()">بحث</button>
  </div>
</div>

<!-- TYPE SELECTOR -->
<div class="type-selector" id="typeSelector">
  <button class="type-btn act-pro" id="tbtn-pro"  onclick="switchType('pro')">LSB PRO</button>
  <button class="type-btn"         id="tbtn-lsb2" onclick="switchType('lsb2')">LSB 2</button>
  <button class="type-btn"         id="tbtn-lsba" onclick="switchType('lsba')">LSB A</button>
</div>

<!-- MAIN TABS -->
<div class="main-tabs">
  <button class="main-tab act-shajr" id="mtab-shajr"  onclick="switchMain('shajr')">🟢 بالتة شجر</button>
  <button class="main-tab"           id="mtab-hayt"   onclick="switchMain('hayt')">🧱 بالتة حائط</button>
  <button class="main-tab"           id="mtab-sheala" onclick="switchMain('sheala')">🔵 شيالات</button>
  <button class="main-tab"           id="mtab-kost"   onclick="switchMain('kost')">📐 كوستيلا</button>
